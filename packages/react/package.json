{
  "name": "@sy-inc/react",
  "version": "0.1.2",
  "description": "🚀 Beautiful and modern React UI library built with Tailwind CSS 4.0.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "author": "SY INC <support@sy-inc.com>",
  "homepage": "https://sy-inc.com",
  "keywords": [
    "next",
    "next ui",
    "sy inc",
    "components",
    "modern components",
    "react components",
    "react ui"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json",
    "./styles": {
      "style": "./src/styles.css",
      "default": "./src/styles.css"
    },
    "./carousel": {
      "import": "./src/components/carousel/index.ts"
    },
    "./checkbox-button-group": {
      "import": "./src/components/checkbox-button-group/index.ts"
    },
    "./file-tree": {
      "import": "./src/components/file-tree/index.ts"
    },
    "./input-phone": {
      "import": "./src/components/input-phone/index.ts"
    },
    "./kpi": {
      "import": "./src/components/kpi/index.ts"
    },
    "./kpi-group": {
      "import": "./src/components/kpi-group/index.ts"
    },
    "./resizable": {
      "import": "./src/components/resizable/index.ts"
    },
    "./rich-text-editor": {
      "import": "./src/components/rich-text-editor/index.ts"
    },
    "./overflow-text": {
      "import": "./src/components/overflow-text/index.ts"
    },
    "./countdown": {
      "import": "./src/components/countdown/index.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sy-inc/sy-ui.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/sy-inc/sy-ui/issues"
  },
  "scripts": {
    "dev": "rollup -c rollup.config.mjs --watch",
    "build": "node scripts/build.mjs --tsc",
    "build:fast": "node scripts/build.mjs",
    "add:component": "node scripts/add-component.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:jsdom": "vitest run --project react-jsdom",
    "test:browser": "vitest run --project react-browser",
    "test:coverage": "vitest run --coverage --project react-jsdom",
    "test:changed": "vitest related --changed --project react-jsdom",
    "prepack": "clean-package && node scripts/update-exports.mjs",
    "postpack": "clean-package restore"
  },
  "clean-package": "./clean-package.config.json",
  "dependencies": {
    "@radix-ui/react-avatar": "1.1.11",
    "@react-stately/utils": "3.12.1",
    "@react-types/color": "3.2.0",
    "@react-types/shared": "3.36.1",
    "@sy-inc/styles": "workspace:*",
    "embla-carousel": "9.0.0-rc03",
    "embla-carousel-autoplay": "9.0.0-rc03",
    "embla-carousel-react": "9.0.0-rc03",
    "input-otp": "1.4.2",
    "react-resizable-panels": "4.12.3",
    "tailwind-merge": "3.4.0",
    "tailwind-variants": "3.3.1"
  },
  "devDependencies": {
    "@iconify/react": "6.0.2",
    "@internationalized/date": "3.12.3",
    "@react-aria/i18n": "3.13.1",
    "@react-aria/ssr": "3.10.1",
    "@react-aria/utils": "3.34.1",
    "@react-stately/data": "3.16.1",
    "@storybook/react": "10.1.10",
    "@sy-inc/standard": "workspace:*",
    "@sy-inc/testing": "workspace:*",
    "@tiptap/core": "3.30.5",
    "@tiptap/extensions": "3.30.5",
    "@tiptap/react": "3.30.5",
    "@tiptap/starter-kit": "3.30.5",
    "@tiptap/suggestion": "3.30.5",
    "@types/fs-extra": "11.0.4",
    "@types/node": "25.0.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "fs-extra": "11.3.3",
    "react": "19.2.8",
    "react-aria": "3.51.0",
    "react-aria-components": "1.20.0",
    "react-dom": "19.2.8",
    "react-phone-number-input": "3.4.18",
    "recharts": "3.10.1",
    "tailwindcss": "4.1.18",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@internationalized/date": "^3.12.3",
    "@react-aria/i18n": "^3.13.1",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "@tiptap/core": "^3.30.5",
    "@tiptap/extensions": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@tiptap/suggestion": "^3.30.5",
    "react": ">=19.0.0",
    "react-aria": "^3.51.0",
    "react-aria-components": "^1.20.0",
    "react-dom": ">=19.0.0",
    "react-phone-number-input": "^3.4.18",
    "tailwindcss": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/extensions": {
      "optional": true
    },
    "@tiptap/react": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    },
    "@tiptap/suggestion": {
      "optional": true
    },
    "react-phone-number-input": {
      "optional": true
    }
  }
}
