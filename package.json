{
  "name": "sy-inc",
  "private": true,
  "version": "0.0.2",
  "license": "MIT",
  "author": {
    "name": "SY INC",
    "email": "support@sy-inc.com",
    "url": "https://sy-inc.com/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sy-inc/sy-inc"
  },
  "scripts": {
    "dev": "dotenv -- turbo dev --filter=@sy-inc/storybook",
    "dev:docs": "dotenv -- turbo dev --filter=@sy-inc/docs",
    "build": "turbo build --filter=@sy-inc/styles --filter=@sy-inc/react",
    "build:docs": "dotenv -- turbo build --filter=@sy-inc/docs",
    "build:docs-cn": "dotenv -- turbo build --filter=@sy-inc/docs-cn",
    "build:react": "turbo build --filter=@sy-inc/react",
    "build:storybook": "dotenv -- turbo build --filter=@sy-inc/storybook",
    "build:sb": "dotenv -- pnpm build:storybook",
    "start:docs": "dotenv -- turbo start --filter=@sy-inc/docs",
    "start:docs-cn": "dotenv -- turbo start --filter=@sy-inc/docs-cn",
    "start:storybook": "dotenv -- turbo start --filter=@sy-inc/storybook",
    "lint": "turbo lint",
    "lint:fix": "turbo lint -- --fix",
    "lint:docs": "dotenv -- turbo lint --filter=@sy-inc/docs",
    "lint:docs-cn": "dotenv -- turbo lint --filter=@sy-inc/docs-cn",
    "lint:react": "turbo lint --filter=@sy-inc/react",
    "lint:storybook": "dotenv -- turbo lint --filter=@sy-inc/storybook",
    "format": "prettier --ignore-path .prettierignore --check .",
    "format:fix": "prettier --ignore-path .prettierignore --write .",
    "typecheck": "turbo typecheck",
    "typecheck:docs": "dotenv -- turbo typecheck --filter=@sy-inc/docs",
    "typecheck:docs-cn": "dotenv -- turbo typecheck --filter=@sy-inc/docs-cn",
    "typecheck:react": "turbo typecheck --filter=@sy-inc/react",
    "typecheck:storybook": "dotenv -- turbo typecheck --filter=@sy-inc/storybook",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage --filter=@sy-inc/react",
    "typegen:docs": "dotenv -- pnpm --filter @sy-inc/docs typegen",
    "typegen:docs-cn": "dotenv -- pnpm --filter @sy-inc/docs-cn typegen",
    "version:bump": "bumpp package.json packages/react/package.json packages/styles/package.json",
    "release": "pnpm run build && bumpp package.json packages/react/package.json packages/styles/package.json --all",
    "clean": "pnpm clean:cache && pnpm i",
    "clean:cache": "find . \\( -name '.turbo' -o -name '.next' -o -name 'dist' -o -name 'node_modules' -o -name '.source' -o -name '.contentlayer' -o -name '.vitest-attachments' -o -name 'coverage' -o -name 'bundle-sizes.json'  -o -name 'tsconfig.tsbuildinfo'  -o -name 'pnpm-lock.yaml' \\) -prune -exec rm -rf '{}' +",
    "upli": "pnpm up --filter \"./**\"  -L -i",
    "prepare": "husky",
    "postinstall": "pnpm --filter @sy-inc/styles build && pnpm typegen:docs && pnpm typegen:docs-cn"
  },
  "devDependencies": {
    "@babel/core": "7.29.6",
    "@babel/preset-react": "7.28.5",
    "@babel/preset-typescript": "7.28.5",
    "bumpp": "11.0.1",
    "@commitlint/cli": "20.2.0",
    "@commitlint/config-conventional": "20.2.0",
    "@eslint/eslintrc": "3.3.3",
    "@eslint/js": "9.39.2",
    "@sy-inc/standard": "workspace:*",
    "@next/eslint-plugin-next": "16.1.1",
    "@rollup/plugin-babel": "6.1.0",
    "@rollup/plugin-commonjs": "29.0.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/node": "25.0.3",
    "@typescript-eslint/eslint-plugin": "8.50.1",
    "@typescript-eslint/parser": "8.50.1",
    "babel-plugin-react-compiler": "19.1.0-rc.3",
    "clean-package": "2.2.0",
    "dotenv": "17.2.3",
    "dotenv-cli": "11.0.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.1.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-only-warn": "1.1.0",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "eslint-plugin-sort-destructure-keys": "2.0.0",
    "eslint-plugin-sort-keys-fix": "1.1.2",
    "eslint-plugin-storybook": "10.2.10",
    "eslint-plugin-unused-imports": "4.3.0",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "jiti": "2.6.1",
    "lint-staged": "16.2.7",
    "parcel": "2.16.4",
    "postcss": "8.5.23",
    "prettier": "3.7.4",
    "prettier-plugin-css-order": "2.1.2",
    "prettier-plugin-tailwindcss": "0.7.2",
    "rollup": "4.59.0",
    "rollup-plugin-peer-deps-external": "2.2.4",
    "rollup-plugin-postcss": "4.0.2",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "turbo": "2.9.14",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.x",
    "pnpm": ">=10.x"
  },
  "packageManager": "pnpm@10.26.2"
}
